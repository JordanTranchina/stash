{
  "name": "stash-tests",
  "version": "1.0.0",
  "description": "Test suite for the Stash web app and Chrome extension",
  "scripts": {
    "test": "jest --testPathPattern=tests/unit",
    "test:e2e": "jest --testPathPattern=tests/e2e --testTimeout=30000",
    "test:extension": "playwright test",
    "test:all": "jest --testTimeout=30000",
    "sync:firefox-extension": "node scripts/sync-firefox-extension.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "puppeteer": "^24.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/unit/**/*.test.js",
      "**/tests/e2e/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/worktrees/"
    ],
    "transform": {}
  }
}
